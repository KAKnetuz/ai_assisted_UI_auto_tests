# === Стенд и учётная запись ===
BASE_URL=https://app.example.com
TEST_USERNAME=your_username_here
TEST_PASSWORD=your_password_here

# === Таймауты, мс (увеличены для SSO) ===
ACTION_TIMEOUT=10000
EXPECT_TIMEOUT=15000
NAVIGATION_TIMEOUT=45000
AUTH_TIMEOUT=45000

# === Браузерный контекст ===
VIEWPORT_WIDTH=1600
VIEWPORT_HEIGHT=1200
LOCALE=ru-RU
TIMEZONE=Europe/Moscow
# true только для тестовых стендов с самоподписанным сертификатом
IGNORE_HTTPS_ERRORS=false

# Браузер, headed-режим, трейсы и видео задаются опциями pytest-playwright:
#   pytest --browser firefox --headed --video retain-on-failure
